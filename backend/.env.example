# Disaster Response Analytics Platform - Backend Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# Database Configuration (Supabase PostgreSQL / SQLite Fallback)
# Leave blank to use the preconfigured local persistent SQLite engine.
# To connect your live Supabase database, execute backend/schema.sql in Supabase SQL editor
# and paste your credentials below:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External API Integrations (Genuine endpoints - Never fabricated)
# NASA FIRMS: Register for free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=

# Open-Meteo Weather Integration (Public API - CC BY 4.0 - No credentials needed)
# Attribution: https://open-meteo.com/
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_WEATHER_LATITUDE=19.0760
DEFAULT_WEATHER_LONGITUDE=72.8777
DEFAULT_WEATHER_LOCATION_NAME="Mumbai Operations Command"
WEATHER_CACHE_TTL_SECONDS=900

# Cache
CACHE_TTL_SECONDS=300

